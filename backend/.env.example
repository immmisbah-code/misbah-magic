# Copy this file to .env and fill in your values

# Users — format: "username1:password1,username2:password2"
# Add as many users as you want separated by commas
USERS=misbah:misbah2024,client1:password123

# Google Gemini API Key (required for PDF mode only)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server settings
PORT=8080
DEBUG=false
